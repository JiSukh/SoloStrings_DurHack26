# Secrets for the voice controls (ElevenLabs) and song lessons (Gemini). NEVER commit a filled-in copy.
# On the board (recommended, outside the app folder so App Lab never syncs it):
#   mkdir -p ~/.config/servo-strummer
#   cp secrets.example.env ~/.config/servo-strummer/secrets.env
#   chmod 600 ~/.config/servo-strummer/secrets.env
# Environment variables with the same names override this file.
ELEVENLABS_API_KEY=
# Optional: a voice id from your ElevenLabs voice library (blank = default voice)
ELEVENLABS_VOICE_ID=
# Optional: a Google Gemini API key. With it, "teach me <any song>" looks up the chords;
# without it only the built-in songs and random chords can be taught.
GEMINI_API_KEY=
# Optional: which Gemini model to ask (blank = gemini-flash-latest)
GEMINI_MODEL=
